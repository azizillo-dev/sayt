# ── Database ────────────────────────────────────────────────
# Production (Neon): use the *pooled* connection string — the host contains "-pooler".
DATABASE_URL=postgres://postgres:password@localhost:5432/portfolio

# ── Auth ────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
# Used only by `npm run db:seed` to create the first admin account.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# Public origin, used for sitemap / Open Graph.
SITE_URL=http://localhost:3000

# ── Media storage ───────────────────────────────────────────
# "local" stores files in ./storage (development); "s3" uses any S3-compatible
# bucket (Neon Object Storage, Cloudflare R2, AWS S3). Vercel has no persistent
# disk, so production must use "s3". The bucket must allow public reads, and
# a CORS rule must allow PUT from the site (the browser uploads straight to it).
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional CDN / custom domain in front of the bucket. Default: S3_ENDPOINT/S3_BUCKET
S3_PUBLIC_URL=

# ── Contact form e-mail (SMTP) ──────────────────────────────
# Gmail: smtp.gmail.com / 465 / an App Password.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ── Auto-translation (optional) ─────────────────────────────
# Google Cloud Translation API key. Without it the free public endpoint is used.
GOOGLE_TRANSLATE_API_KEY=
